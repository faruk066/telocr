# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=buraya_telegram_bot_tokeninizi_yazin

# --- Google Gemini API ---
# https://aistudio.google.com/app/apikey adresinden alinir
GEMINI_API_KEY=buraya_gemini_api_keyinizi_yazin

# --- NVIDIA NIM yedek saglayici (opsiyonel) ---
# https://build.nvidia.com adresinden alinir (nvapi-... ile baslar)
NVIDIA_API_KEY=buraya_nvidia_api_keyinizi_yazin
# Gorsel+JSON ureten model (NVIDIA NIM ucretsiz kanal).
# Secim: moonshotai/kimi-k3 (reasoning model; daha guclu, daha yavas)
# Eski: meta/llama-3.2-11b-vision-instruct (hizli ama 22 satirlik gercek
#       formda JSON yerine prose/madde listesi uretiyordu)
NVIDIA_MODEL=moonshotai/kimi-k3
# Kimi-K3 uretim parametreleri (reasoning model)
# OLÇÜLDÜ: effort=low -> 117 sn'de dogru JSON | effort=max -> gateway 504 (302 sn)
# "max" denemek isterseniz burayi max yapin (Render: NVIDIA_REASONING_EFFORT).
NVIDIA_TEMPERATURE=1
NVIDIA_SEED=0
NVIDIA_REASONING_EFFORT=low
NVIDIA_FALLBACK_REASONING_EFFORT=low
# Saglayici sirasi: gemini once, hata/kota durumunda nvidia denenir.
# Sadece nvidia kullanmak icin: AI_PROVIDER_ORDER=nvidia
AI_PROVIDER_ORDER=gemini,nvidia
# NVIDIA toplam timeout (sn). reasoning_effort=max oldugu icin ilk token
# geci gelebiliyor; 600 sec onerilir.
NVIDIA_TIMEOUT_S=600
# NVIDIA oncesi gorsel kucultme (hiz icin; Gemini yolunu etkilemez)
NVIDIA_IMAGE_MAX_LONG_EDGE=1280
NVIDIA_IMAGE_JPEG_QUALITY=80
# Cikti token limiti (kimi-k3 icin 16384)
NVIDIA_MAX_TOKENS=16384

# --- Opsiyonel ---
# Birincil Gemini modeli (el yazisi dogrulugu icin en guclu).
# Tier1 oranlariniza gore: gemini-2.5-flash (RPM 1K / TPM 1M / RPD 10K).
GEMINI_MODEL=gemini-2.5-flash
# Kota dostu yedek havuzu: birincil 429/404 verirse sirayla denenir.
# Tier1'de RPD'si genis olanlar secildi (her biri 150K/gun):
# gemini-3.5-flash-lite (RPM 4K / TPM 4M / RPD 150K), gemini-3.1-flash-lite (ayni).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
